# Copy this file to a server-side secret/env file and fill real values there.
# Do not commit real production secrets.

LABMANAGER_PY_APP_ENV=production
LABMANAGER_PY_LOG_LEVEL=INFO
LABMANAGER_PY_READINESS_STRICT=true
LABMANAGER_PY_SCHEMA_CHECK_ON_READINESS=true

# Compose-local defaults. Replace with managed service URLs when using managed PostgreSQL/Redis.
LABMANAGER_PY_DATABASE_URL=postgresql://labmanager:change-me@postgres:5432/labmanager
LABMANAGER_PY_REDIS_URL=redis://redis:6379/0
LABMANAGER_PY_CELERY_BROKER_URL=redis://redis:6379/1
LABMANAGER_PY_CELERY_RESULT_BACKEND=redis://redis:6379/2

LABMANAGER_PY_LANGGRAPH_ENABLED=false

# Enable the formal Python workflow surfaces in production.
# Without these flags, /api/ai/* stays on compat_fallback and the frontend
# task list will not reflect tasks persisted by rules.scan_and_execute.
LABMANAGER_PY_PY_BACKEND_RULES_ENABLED=true
LABMANAGER_PY_PY_BACKEND_TASKS_ENABLED=true
LABMANAGER_PY_PY_BACKEND_APPROVALS_ENABLED=true
LABMANAGER_PY_PY_BACKEND_REPORT_ENABLED=true
LABMANAGER_PY_PY_BACKEND_REPORT_PDF_ENABLED=true

# Optional LLM integration.
LABMANAGER_PY_LLM_API_KEY=
LABMANAGER_PY_LLM_ENDPOINT=
LABMANAGER_PY_LLM_MODEL=

# Optional report email delivery.
LABMANAGER_PY_SMTP_HOST=
LABMANAGER_PY_SMTP_PORT=587
LABMANAGER_PY_SMTP_USE_SSL=false
LABMANAGER_PY_SMTP_USER=
LABMANAGER_PY_SMTP_PASSWORD=
LABMANAGER_PY_SMTP_FROM=
LABMANAGER_PY_SUPERVISOR_REPORT_EMAIL=
LABMANAGER_PY_SUPERVISOR_REPORT_NAME=Supervisor
LABMANAGER_PY_SUPERVISOR_REPORT_BASE_URL=https://labmanager.example.com

