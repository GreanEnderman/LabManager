# AI Gateway Mode - Test/staging/production must use 'http' to validate backend through /api/ai
# Omitting this variable defaults to 'http'. Any other value will fail at runtime.
VITE_AI_GATEWAY_MODE=http

# AI API Base URL - Defaults to '/api/ai' (proxied by Vite dev server or production reverse proxy)
# Override only when targeting a different backend endpoint for integration testing
VITE_AI_API_BASE_URL=http://localhost:8787/api/ai

# Optional HTTP Basic Auth Bootstrap - Used only for automated HTTP login during integration
# These credentials assist the HTTP auth flow and do NOT bypass backend authentication
# Leave empty for manual login or when using other auth mechanisms
VITE_AI_HTTP_USERNAME=
VITE_AI_HTTP_PASSWORD=
